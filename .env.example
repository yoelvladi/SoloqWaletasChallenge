# Copia este archivo como .env.local. Guarda tu clave solo en ese archivo.
# Obtén la clave en https://developer.riotgames.com/
RIOT_API_KEY=
SCOREBOARD_PUBLIC=true

# Administración protegida. SCOREBOARD_PUBLIC=false activa el acceso privado al tablero.
# Genera AUTH_SECRET con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_URL=http://127.0.0.1:3000
ADMIN_EMAIL=
AUTH_SECRET=

# Carpeta de datos privados. En local se usa ./data si está vacío.
# Para publicar, usa una ruta absoluta en un volumen persistente.
DATA_DIR=

# Correo opcional en modo público; necesario para invitaciones privadas remotas.
# Recomendado en Railway Free/Trial/Hobby: correo por HTTPS con Resend.
# Configura un remitente de un dominio verificado en Resend.
RESEND_API_KEY=
MAIL_FROM=

# Alternativa SMTP para local u otros proveedores (Railway requiere Pro).
# Utiliza las credenciales SMTP de tu proveedor, nunca tu contraseña habitual de Gmail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
